# ============================================================
# haut-seat-helper 环境变量模板
# 用法：复制本文件为 .env 后按需修改。.env 已被 .gitignore 排除，
# 切勿将 .env 或任何真实凭据提交到版本库。
# 认证相关字段为占位；本项目**不做**账号密码自动登录，也不识别或绕过验证码。
# 认证方式与失效判定见 README「认证机制与登录有效期」。
# ============================================================

# 服务端基地址（不含结尾斜杠）
HAUT_BASE_URL=https://wslib.haut.edu.cn

# HTTP 请求设置
HAUT_REQUEST_TIMEOUT_S=10
HAUT_MAX_RETRY=2
HAUT_MIN_INTERVAL_S=1.0

# ---- 查询默认参数（以浏览器正常查询为参考，非敏感；CLI 参数可覆盖）----
HAUT_REGIONID=16
HAUT_PAGE_SIZE=10

# ---- 非敏感请求头（凭据类请求头由 HAUT_COOKIE / HAUT_AUTHORIZATION 单独处理）----
# 以下为可选覆盖项，默认值见 config.py；留空（不设置）即不发送对应头。
# HAUT_HTTP_ACCEPT=application/json, text/plain, */*
# HAUT_HTTP_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9
# HAUT_HTTP_REFERER=            # 浏览器查询页面的 Referer 地址；不确定就留空
# HAUT_HTTP_USER_AGENT=haut-seat-helper/0.1 (personal read-only)

# 真实预约开关：当前阶段必须保持 false。
# 仅当确认学校规则允许、且后续实现并验证通过后才考虑开启。
HAUT_ENABLE_REAL_BOOKING=false

# 暂停旗标文件路径：该文件存在时，暂停一切真实预约（只读查询不受影响）
HAUT_PAUSE_FILE=data/pause.flag

# 座位优先级配置（JSON 文件路径）
HAUT_SEATS_CONFIG=config/seats.json

# 预约任务配置（JSON 文件路径；book 命令使用）
HAUT_BOOKING_CONFIG=config/booking.json

# addbooking 的 channel 参数（已观察到的示例值 1001；未确认适用所有场景）
HAUT_BOOKING_CHANNEL=1001

# ---- 预约开放时刻（官方规则：07:00 开放，21:30 截止）之前的行为 ----
# 1) 窗口当天 07:00 之前**只做只读查询，绝不提交**：提前启动
#    （HAUT_SCHEDULER_TRIGGER_LEAD_S）或窗口内补跑都不会把提交提前到开放之前，
#    等待期间按 30 秒重新查询，开放那一刻立刻查询并提交。
# 2) 如果服务器在**提交**时明确回复「尚未开放」，那一次提交不算失败次数、也不结束
#    这次运行：程序退回只读查询、按 30 秒重试，直到窗口关闭为止。
#    识别词由你按**实测文案**填写（逗号分隔）；默认留空 = 不启用。
#
#    为什么默认留空：服务器「未开放」响应的真实文案我们从未观察到，凭空猜词会把一次
#    永久性失败误判成「稍后再试」。首次遇到时，真实文案会原样出现在运行事件里
#    （形如「重试次数耗尽(3次)：<服务器 msg>」），把其中稳定出现的片段抄进来即可。
# HAUT_NOT_OPEN_KEYWORDS=尚未开放,未开放

# 日志
HAUT_LOG_LEVEL=INFO
HAUT_LOG_FILE=logs/haut_seat.log

# ---- 会话凭据（复用你在浏览器正常登录后的会话；仅写入本地 .env，绝不入库/日志/代码）----
# 认证载体是同一个 JWT 令牌，两个头都要配（实测结论）：
#   * 服务端只校验 Authorization 请求头；Authorization 一旦失效即返回
#     HTTP 200 + 业务 code=401（"认证失败，无法访问系统资源"），此时程序会立即停止。
#   * 只配 HAUT_COOKIE 时，请求会按匿名放行并正常返回座位，
#     因此「只配 Cookie」无法验证登录状态，也得不到失效提示 —— 两个都要配。
#   * 令牌里没有 exp（过期时间）、响应里没有 Set-Cookie / refresh token，
#     故当前不支持自动续期，会话失效后需重新登录（见下方「凭据来源」）。
# 取值方式（两种任选）：
#   A) 手工：浏览器 F12 → Network → 任选一个 /stage-api/ 请求 → 复制请求头。
#   B) 自动：python -m haut_seat auth-login  ← 打开浏览器由你本人登录，自动存快照
# 更新后务必运行：python -m haut_seat check-auth  （只读预检，不会提交预约）
#HAUT_AUTHORIZATION=     # Authorization 请求头完整值，形如 "Bearer xxx.yyy.zzz"
#HAUT_COOKIE=            # Cookie 请求头里 Admin-Token= 的那一段（与上面的令牌相同）

# ============================================================
# 凭据来源与自动获取（可选；全部有默认值，不配也能跑）
# ============================================================
# 本次请求到底用哪一对凭据，由下面的 auth_source 决定：
#   auto（默认）快照与 .env 里**较新**的一方胜出（用 .env 的修改时间作真实信号）
#   browser     只用快照；快照缺失/损坏时**明确报错并阻断提交**，绝不回退到可能
#               已过期的 .env（这是刻意的：宁可停下报错，也不用过期凭据）
#   env         只用 .env，与从前逐字节一致（连快照文件都不读）
# 想完全保持旧的手工流程，就设为 env。
# HAUT_AUTH_SOURCE=auto

# 凭据快照与专用浏览器目录（均在 data/ 下，已被 .gitignore 排除）
# 快照是受限权限文件（POSIX 下 0600；Windows 的 POSIX 权限位不生效，
# 实际防护是"位于用户 profile 内 + 被 .gitignore 排除 + 从不打印值"）。
# 页面与日志**只读元数据**（来源、时间、单向指纹），从不显示凭据值。
# HAUT_AUTH_DIR=data/auth
# HAUT_AUTH_SNAPSHOT_FILE=data/auth/credentials.json
# HAUT_AUTH_PROFILE_DIR=data/auth/browser-profile

# 人工登录用的浏览器通道。msedge = 复用系统已装的 Edge，**不下载任何浏览器**。
# 装了 Edge 就不用改；要用 Chrome 可填 chrome，要用 Playwright 自带的内核则填 chromium
#（后者需自行执行 playwright install，本项目不会替你下载）。
# HAUT_AUTH_BROWSER_CHANNEL=msedge

# 等待你本人完成登录的上限（秒）。登录页有图形验证码，请留足时间。
# HAUT_AUTH_LOGIN_TIMEOUT_S=300

# 只读预检结果的复用窗口（秒）。0 = 关闭（默认，每次预检都真实探测）。
# >0 时，同一凭据在窗口内重复预检会直接复用上次的"有效"结论，避免触发时刻
# 前后对同一凭据反复做昂贵探测。只复用"有效"：失效/无法判断一律重新探测，
# 安全闸门不会因缓存变松。换凭据（指纹变化）即自动失效。
# HAUT_AUTH_CHECK_TTL_S=120

# ---- 远程浏览器登录（在面板里直接操作服务器上的浏览器）----
# 解决的问题：auth-login 用的是 headless=False（人工必须**看到**登录页），
# 部署到没有图形桌面的服务器（systemd 服务、会话 0、无 X）后必然失败。
# 远程浏览器用无头 Chromium + 截图轮询把画面送回面板，键鼠事件反向转发。
# 人工环节一步都没省：图形验证码仍由你本人识别，程序不代填口令、不识别验证码、
# **默认全部沿用下面的默认值即可，服务器 .env 一行都不用改**。
#
# 关掉整个功能（页面只显示"已禁用"，路由一律拒绝）：
# HAUT_AUTH_REMOTE_ENABLED=true
#
# 用的浏览器通道。空 = playwright 自带的 Chromium（需先执行
#   PLAYWRIGHT_BROWSERS_PATH=<项目>/.cache/ms-playwright \
#     python -m playwright install chromium
# —— 也就是**安装时**就指定项目目录；systemd 单元里的同名变量必须与它逐字一致。
# 不给这个变量时浏览器会装到 $HOME/.cache/ms-playwright，单元里就找不到，
# 症状是"明明装了却说找不到浏览器"。**不要**在这里填 msedge：
# 那个通道是给桌面 CLI 用的，Linux 服务器上没有 Edge。
# HAUT_AUTH_REMOTE_CHANNEL=
#
# 远端浏览器视口（截图尺寸按它截，点击坐标也按它换算）
# HAUT_AUTH_REMOTE_VIEWPORT_W=1280
# HAUT_AUTH_REMOTE_VIEWPORT_H=800
#
# 画面刷新间隔（毫秒）与 JPEG 质量。实测 1280x800 / q70 每帧约 50ms、约 10.9KB，
# 600ms 一帧约合单核 8%；调小更跟手、更费 CPU。
# HAUT_AUTH_REMOTE_FRAME_INTERVAL_MS=600
# HAUT_AUTH_REMOTE_JPEG_QUALITY=70
#
# 多久没有键鼠输入就自动关掉浏览器并释放会话（秒）
# HAUT_AUTH_REMOTE_IDLE_TIMEOUT_S=900
#
# 明文 HTTP 下是否允许启动远程会话。默认允许，但页面会红字告警：明文链路上会有
# 管理会话 Cookie、登录页画面**以及学校账号口令的按键**。
# 设为 false 即"仅 HTTPS"（配反代 TLS，或先用 ssh -L 8080:127.0.0.1:8080 隧道）。
# HAUT_AUTH_REMOTE_ALLOW_INSECURE=true

# 一次性采集命令（人工完成验证码；这不是自动登录，人工环节不可省）：
#   pip install -e ".[auth]"
#   python -m haut_seat auth-login      # 在弹出的浏览器里正常登录，成功后窗口自动关闭
#   python -m haut_seat auth-status     # 只读确认来源与指纹
# 预约路径**永不**自动拉起浏览器：登录必须有人看着，且无人值守时拉起交互窗口
# 会把"认证失效→等待人工"这个清晰结论变成运行期异常。

# ---- 预留占位（暂未使用；本项目不实现账号密码自动登录）----
# HAUT_TOKEN=
# HAUT_USERNAME=
# HAUT_PASSWORD=

# ============================================================
# Web 管理面板（可选功能）
# 安装：pip install -e ".[web]"
# 启动：python -m haut_seat web --init-db
# 详细部署步骤见 docs/web-deploy.md
# ============================================================

# 监听地址。**安全默认 127.0.0.1**：只允许本机访问，外部通过 nginx/HTTPS 反向代理。
# 除非在完全可信的内网，否则不要改成 0.0.0.0（会以明文 HTTP 暴露登录页）。
HAUT_WEB_HOST=127.0.0.1
HAUT_WEB_PORT=8080

# Web 面板的 SQLite 数据库（含管理员 scrypt 哈希、计划、运行记录）。
# 该文件在 data/ 下，已被 .gitignore 排除；备份方式见 docs/web-deploy.md。
HAUT_WEB_DB=data/web.db

# 通过 HTTPS 访问时置 true → 会话 Cookie 增加 Secure 属性（HTTP 下置 true 会导致无法登录）。
# 这是**静态开关**：应用不会根据 X-Forwarded-Proto 自动判断，只要对外走 HTTPS 就必须设 true。
HAUT_WEB_SESSION_SECURE=false

# 可选。默认 false 时 uvicorn 自己会解析 X-Forwarded-For（默认只信任 127.0.0.1/::1 的本机来源），
# 默认部署（HAUT_WEB_HOST=127.0.0.1 + 同机 nginx）下记到的就已经是真实客户端 IP，够用。
# 置 true 时应用自己取该头**最右一项** —— 即紧邻代理追加的真实来源；客户端自填的左半部分无效。
# 两种情况都**不要**改成取最左项：那是客户端可随意伪造的，等于限流形同虚设。
# 只有确实有代理时才考虑置 true（且服务不能被绕过代理直连）。
# 另外**不要**设置 FORWARDED_ALLOW_IPS=*，那会让任意客户端直接伪造来源地址。
HAUT_WEB_TRUST_PROXY=false

# 是否允许「无管理员时在网页上创建第一个管理员」。
# 首次部署方便，但若服务已经能被公网访问，建议先置 false、用 CLI 建管理员：
#   python -m haut_seat create-admin --username 你的用户名
# 状态变更后重启服务生效。
HAUT_WEB_ALLOW_FIRST_RUN_SETUP=true

# 后台调度器总开关。关掉后 Web 面板仍可查看/编辑计划，但不会有任何计划被自动触发。
HAUT_WEB_ENABLE_SCHEDULER=true

# 调度器轮询间隔（秒）与同时运行的任务数上限
HAUT_SCHEDULER_TICK_S=5.0
HAUT_SCHEDULER_MAX_CONCURRENT=3

# 运行记录/日志保留天数（「系统」页的「维护」按钮按此清理）
HAUT_SCHEDULER_RUN_LOG_KEEP_DAYS=30

# ---- 邮件通知口令（仅预留；SMTP 尚未实现，填了也不会发信）----
# 口令只从环境变量读取，**不入库、不入日志、不出现在页面上**。
# 通知设置页里填的是「读取口令的环境变量名」，不是口令本身。
# HAUT_SMTP_PASSWORD=

# ============================================================
# 用户端（多用户）：每人登录**自己**的图书馆账号
# 页面：/booking（自助注册 + 绑定 + 自己的预约）；管理端 /admin/users
# 用法与限制见 README 的「多用户」一节，部署见 docs/web-deploy.md 第 3 节
# ============================================================

# 自助注册的**部署侧急停**。它与管理端的开关（/admin/users 页面上那个）必须
# **同时**为真才开放注册；任一为假都注册不了。已登录用户不受影响。
# 默认 true，但要真正开放还得管理员在 /admin/users 上生成邀请码并打开开关。
HAUT_WEB_SIGNUP_ENABLED=true

# 邀请码的默认值。数据库里存了邀请码时以数据库为准（管理员可以在页面上随时换）。
# 两者都为空 ⇒ 没有邀请码 ⇒ 谁也注册不了（页面会如实说明，不会悄悄放行）。
# HAUT_WEB_SIGNUP_INVITE_CODE=

# 用户端会话（Cookie 名 hs_user，path=/booking，与管理员会话完全独立的一套）。
# TTL 默认 72 小时，比管理员的 12 小时长：用户端是"手机上偶尔点一下"的场景，
# 频繁被踢下线会让人看不到自己的状态。空闲超时默认 240 分钟。
# HAUT_USER_SESSION_TTL_HOURS=72
# HAUT_USER_SESSION_IDLE_MINUTES=240

# 绑定登录时，服务端取回的验证码（uuid）在会话里的有效期（秒）。
# 超时后必须重新取一张图 —— 这是一次一图，不做任何"重试同一张图"的逻辑。
# HAUT_USER_CAPTCHA_TTL_S=300

# ---- 每用户学校凭据的加密主密钥 ----
# 每个用户自己的 Cookie / Authorization 用 AEAD 加密后单独保存
#（services/credential_crypto.py：scrypt + SHAKE256 密钥流 + HMAC-SHA256，
# 先验标签再解密；AAD 绑定 user_id 与字段名 ⇒ 密文搬不到别人名下）。
# 主密钥来源二选一：
#   1) 下面这个文件（首次有人绑定时自动生成 32 字节）
#   2) HAUT_AUTH_CRED_KEY —— 十六进制 / base64 / ≥16 字节原文；配了它就**不读也不改写**文件
#      （简写 HAUT_CRED_KEY 也认；两个都设时以 HAUT_AUTH_CRED_KEY 为准 ——
#       这两个名字是文档与代码核对过的，写哪个都生效。除此之外的名字一律无效，
#       且**不会**有任何提示，所以请照抄本行的键名。）
# ⚠️ 主密钥丢失 ⇒ 所有已绑定的凭据都解不开，每个人都要重新绑定一次。
#    请与 data/web.db 一起备份它，且**不要**提交进版本库。
# HAUT_AUTH_MASTER_KEY_FILE=data/auth/master.key
# HAUT_AUTH_CRED_KEY=

# 出站 HTTP 客户端的 LRU 条数上限。客户端按**凭据指纹**分桶
#（多用户下每个用户各一份，不同账号绝不共用连接与会话状态）。
# 同时活跃的用户数超过它时会反复重建连接池 —— 人多了就调大。
# HAUT_HTTP_CLIENT_CACHE_MAX=8
